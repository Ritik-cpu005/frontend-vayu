{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Vayu in Edge",
            "type": "msedge",
            "request": "launch",
            "url": "http://127.0.0.1:8000/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "Attach to Edge",
            "type": "msedge",
            "request": "attach",
            "port": 9222,
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "msedge",
            "name": "http://127.0.0.1:3000/index.html",
            "request": "launch",
            "url": "http://127.0.0.1:3000/index.html"
        }
    ]
}